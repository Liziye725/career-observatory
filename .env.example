# Load using Node --env-file=.env or export in shell. Never commit filled secrets.
DATA_DIR=.data
PORT=8787
# Gmail read-only OAuth; grant gmail.readonly in your own Google project.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# External research executable: receives request JSON path and output JSON path.
# It must read evidence and produce the documented bundle. No bundled model assumed.
RESEARCH_EXECUTABLE=
# Optional private Sites publication; leave empty for local-only.
SITE_URL=
SITE_SERVICE_TOKEN=
